# Vercel frontend: Render signaling URL
NEXT_PUBLIC_SIGNALING_URL=http://localhost:3001
# Vercel server only: Metered TURN fallback (never use NEXT_PUBLIC_ prefixes)
METERED_DOMAIN=your-app.metered.live
METERED_TURN_API_KEY=your-credential-api-key
# Signaling host only: permitted frontend origins, comma-separated
# CLIENT_ORIGIN=http://localhost:3000,https://your-app.vercel.app

# Optional Send for later: server-only Supabase credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key
# Random secret of at least 32 characters for scheduled cleanup
CRON_SECRET=set-a-random-secret
